# Server-Adresse der gemeinsamen Einkaufsliste (ohne abschliessenden Slash).
#
# In der App ist bereits eine Standard-Adresse hinterlegt
# (siehe src/config/syncServer.ts). Diese Variable nur setzen, wenn der Server
# unter einer anderen Domain laeuft.
#
# Beispiel: EXPO_PUBLIC_SYNC_URL=https://kalorienkompass-sync.onrender.com
EXPO_PUBLIC_SYNC_URL=

# MongoDB-Verbindung fuer den Synchronisierungs-Server (nur Server-seitig!).
# Diese Datei ist eine Vorlage. Die echten Werte gehoeren in eine lokale
# .env-Datei, die nicht eingecheckt wird.
#
# Lokal:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://BENUTZER:PASSWORT@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Wichtig: Sonderzeichen im Passwort muessen URL-kodiert werden,
# z. B. % -> %25, ! -> %21, @ -> %40.
MONGODB_URI=mongodb+srv://BENUTZER:PASSWORTcluster0.xxxxx.mongodb.net/
