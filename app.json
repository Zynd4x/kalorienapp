{
  "expo": {
    "name": "KalorienKompass",
    "slug": "kalorienkompass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kalorienkompass",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kalorienkompass.app"
    },
    "android": {
      "package": "com.kalorienkompass.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "KalorienKompass benötigt Zugriff auf die Kamera, um Barcodes von Lebensmitteln zu scannen."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
